<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Password Input -->
    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Password"
        android:inputType="textPassword"
        android:padding="12dp"
        android:background="@drawable/input_background" />

    <!-- Toggle Visibility -->
    <ImageView
        android:id="@+id/toggleVisibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:layout_toEndOf="@id/passwordInput"
        android:src="@drawable/ic_visibility_off"
        android:contentDescription="Toggle Password Visibility" />

    <!-- Entropy Result -->
    <TextView
        android:id="@+id/entropyResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/passwordInput"
        android:layout_marginTop="16dp"
        android:text="Entropy: 0 bits"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Feedback Message -->
    <TextView
        android:id="@+id/feedbackMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/entropyResult"
        android:layout_marginTop="8dp"
        android:text="Password Strength Feedback"
        android:textSize="14sp" />

    <!-- Best Entropy -->
    <TextView
        android:id="@+id/bestEntropyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/feedbackMessage"
        android:layout_marginTop="16dp"
        android:text="Best Entropy: 0 bits"
        android:textSize="16sp"
        android:textStyle="italic" />

    <!-- Info Button -->
    <ImageView
        android:id="@+id/infoButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_below="@id/bestEntropyText"
        android:layout_marginTop="16dp"
        android:src="@drawable/ic_info"
        android:contentDescription="Info Button" />

</RelativeLayout>