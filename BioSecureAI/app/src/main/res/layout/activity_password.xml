<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Password Input -->
    <EditText
        android:id="@+id/passwordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Enter Password"
        android:inputType="textPassword"
        android:padding="12dp"
        android:background="@drawable/input_background" />

    <!-- Toggle Visibility -->
    <ImageView
        android:id="@+id/toggleVisibility"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:layout_toEndOf="@id/passwordInput"
        android:src="@drawable/ic_visibility_off"
        android:contentDescription="Toggle Password Visibility" />

    <!-- Entropy Result -->
    <TextView
        android:id="@+id/entropyResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/passwordInput"
        android:layout_marginTop="16dp"
        android:text="Entropy: 0 bits"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Feedback Message -->
    <TextView
        android:id="@+id/feedbackMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/entropyResult"
        android:layout_marginTop="8dp"
        android:text="Password Strength Feedback"
        android:textSize="14sp" />

    <!-- Best Entropy -->
    <TextView
        android:id="@+id/bestEntropyText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/feedbackMessage"
        android:layout_marginTop="16dp"
        android:text="Best Entropy: 0 bits"
        android:textSize="16sp"
        android:textStyle="italic" />

    <!-- Check Button -->
    <Button
        android:id="@+id/checkButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Check Password Strength"
        android:padding="12dp"
        android:layout_marginTop="16dp"/>

    <!-- Result Text -->
    <TextView
        android:id="@+id/resultText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:padding="12dp"
        android:textSize="16sp"
        android:background="#EFEFEF"
        android:textColor="#000"
        android:layout_marginTop="12dp"/>

    <!-- Info Button -->
    <TextView
        android:id="@+id/infoText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note : Password entropy is a measure of how unpredictable or strong your password is. It is calculated based on the length of the password and the variety of characters used (e.g., lowercase, uppercase, numbers, symbols). A higher entropy indicates a stronger password that is harder to crack."
        android:padding="12dp"
        android:textSize="16sp"
        android:background="#EFEFEF"
        android:textColor="#000"
        android:layout_marginTop="12dp"/>

</LinearLayout>